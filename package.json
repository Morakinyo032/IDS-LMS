{
  "name": "lms-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter @lms/database exec prisma migrate dev",
    "db:studio": "pnpm --filter @lms/database exec prisma studio",
    "db:generate": "pnpm --filter @lms/database exec prisma generate"
  },
  "devDependencies": {
    "turbo": "2.0.0",
    "typescript": "5.3.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}